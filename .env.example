# ==========================================
# 茶楼棋牌系统环境变量配置模板 (.env)
# ==========================================

# 1. 公网访问域名 (Telegram 官方 Webhook 强制要求 HTTPS 地址)
# 若使用 Cloudflare Tunnel、ngrok 或自建穿透，请填写穿透后的 HTTPS 域名 (末尾不要加斜杠)
# 示例: APP_URL="https://mychess.trycloudflare.com"
APP_URL="https://your-public-domain.com"

# 2. Telegram Bot Token
# 从 Telegram 官方机器人之父 @BotFather 创建 Bot 获取到的 API Token
# 示例: TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# 3. 超级管理员手机号 (注册该手机号直接获得游戏内【👑 超级管理员】特权)
# 多个可用逗号分隔
TELEGRAM_ADMIN_PHONE="13800138000"

# 4. 允许注册的手机号白名单 (逗号分隔)
# 只有在白名单内的手机号才可在网页前端注册登录，严防外部人员乱入
TELEGRAM_AUTHORIZED_PHONES="13800138000,13900139000,13700137000"

# 5. 管理员 Telegram 用户名白名单 (无需包含 @ 符号，逗号分隔)
# 示例: TELEGRAM_ADMIN_USERNAMES="my_tg_username,boss_account"
TELEGRAM_ADMIN_USERNAMES="admin_username"

# 6. Telegram Webhook 密钥安全令牌 (可选推荐)
# Telegram 官方推送时将在 HTTP 请求头附带 X-Telegram-Bot-Api-Secret-Token 进行防伪校验
# 示例: TELEGRAM_WEBHOOK_SECRET="super_secret_token_12345"
TELEGRAM_WEBHOOK_SECRET=""

# 7. 生产环境是否允许内置 Demo 测试账号登录 (可选，默认 true)
# 商业上线或仅对白名单开放时，可设为 false 以全面禁用 13800138000 等预置演示账号
# 示例: ENABLE_DEMO_ACCOUNTS="false"
ENABLE_DEMO_ACCOUNTS="true"



